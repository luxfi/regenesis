# Lux Mainnet Regenesis Configuration
# ======================================
# Copy this file to .env and set your mnemonic

# BIP39 mnemonic for deterministic validator key generation
# Mainnet validators use accounts 0-4
# Testnet validators use accounts 5-9
MAINNET_MNEMONIC="your 24 word mnemonic phrase goes here"

# Network configuration (default: 96369)
NETWORK_ID=96369

# Number of bootstrap validators (default: 5)
VALIDATORS=5

# Subnet ID for C-chain replay source (default: 96369)
SUBNET_ID=96369
